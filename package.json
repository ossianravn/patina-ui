{
  "name": "patina-ui",
  "private": true,
  "version": "0.0.0",
  "description": "A shadcn/ui component library in a printed-matter style: paper, riso inks, hand-drawn marks and seeded generative prints.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ossianravn/patina-ui.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node tools/check-contrast.mjs",
    "build:textures": "node tools/paper/build-textures.mjs",
    "registry": "node tools/registry/build.mjs",
    "registry:check": "node tools/registry/build.mjs --check",
    "test:consumer": "node --test tests/consumer/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/caveat": "^5.3.0",
