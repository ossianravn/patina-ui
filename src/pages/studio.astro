---
import Base from "@/site/layouts/base.astro"
import { Studio } from "@/site/studio/studio"
---

<Base
  title="Theme studio"
  description="Paper, inks, accent, variation, patina, density and the interface face, on Fieldbook and every kind of part at once, exported as CSS or a shadcn registry item."
>
  <div class="mx-auto max-w-[76rem] px-snug pt-section sm:px-line">
    <p class="label-mono m-0 text-ink-2">
      Patina UI · <a href="/docs">Docs</a>
    </p>
    <h1 class="mb-tight mt-tight text-title">Theme studio</h1>
    <p class="m-0 max-w-measure text-ink-2">
      Choose the paper, inks and type, watch them land on Fieldbook and every
      kind of part, then take the theme away as CSS or a shadcn item.
    </p>
  </div>
  <div class="mx-auto mt-section max-w-[76rem] px-snug sm:px-line">
    <Studio client:load />
  </div>
</Base>
