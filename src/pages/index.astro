---
import Base from "@/site/layouts/base.astro"
import { AppearanceControls } from "@/site/components/appearance-controls"
import Hero from "@/site/specimen/hero.astro"
import PaperInks from "@/site/specimen/paper-inks.astro"
import VoicesScale from "@/site/specimen/voices-scale.astro"
import Marks from "@/site/specimen/marks.astro"
import Prints from "@/site/specimen/prints.astro"
---

<Base
  title="Patina UI"
  description="A shadcn/ui component library in a printed-matter style. Phase 0 specimen: paper, inks, voices, marks and seeded prints."
>
  <Hero />
  <div class="mx-auto max-w-[76rem] px-snug sm:px-line">
    <div class="rounded-sheet bg-paper-2 px-snug py-tight">
      <AppearanceControls client:load />
    </div>
  </div>
  <Prints />
  <PaperInks />
  <VoicesScale />
  <Marks />
</Base>
