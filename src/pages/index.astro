---
// Home: the language at its best, and installing within a minute. The hero is the Hero01 block; the rest render at
// build time, with islands only where something moves or is chosen.
import Base from "@/site/layouts/base.astro"
import ComponentIndex from "@/site/home/component-index.astro"
import { HomeHero } from "@/site/home/hero"
import History from "@/site/home/history.astro"
import InUse from "@/site/home/in-use.astro"
import Install from "@/site/home/install.astro"
---

<Base
  title="Patina UI"
  description="A shadcn/ui component library in a printed-matter style: warm paper, riso inks, hand-drawn marks and seeded prints, installed from its own registry."
>
  <HomeHero client:load />
  <History />
  <InUse />
  <ComponentIndex />
  <Install />
</Base>
