---
// Not found: said plainly, with the way back. nginx serves it for any missing path.
import Base from "@/site/layouts/base.astro"
import { Print } from "@/patina/print/print"
---

<Base title="Page not found" description="There is no page at this address.">
  <div class="mx-auto grid max-w-[76rem] items-center gap-x-page gap-y-line px-snug py-section sm:px-line md:grid-cols-[minmax(0,1fr)_16rem]">
    <div class="min-w-0">
      <p class="label-mono m-0 text-ink-2">404 · Not found</p>
      <h1 class="mb-tight mt-tight text-title">Nothing printed here</h1>
      <p class="m-0 max-w-measure text-ink-2">
        The address may be old or mistyped. Start again from the{" "}
        <a href="/">home page</a>, or go straight to the{" "}
        <a href="/docs">components</a>.
      </p>
    </div>
    <Print
      motif="rings"
      seed="lost-plover"
      className="mx-auto w-full max-w-[12rem] md:max-w-none"
    />
  </div>
</Base>
