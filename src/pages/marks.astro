---
import Base from "@/site/layouts/base.astro"
import { GLYPHS } from "@/patina/ink/glyphs"
import { Highlight } from "@/patina/marks/highlight"
import { HandUnderline } from "@/patina/marks/hand-underline"
import { Bracket, Circle, Strike } from "@/patina/marks/hand-marks"
import { RoughRule, SketchFrame, Tape, Wash } from "@/patina/marks/paper-marks"
import { Annotation, MarginNote } from "@/patina/marks/notes"
import { Stamp } from "@/patina/marks/stamp"
import { Glyph } from "@/patina/marks/glyph"
---

<Base
  title="Marks"
  description="The marks Patina adds to the page: highlights, rings, frames, tape, notes, stamps and glyphs."
>
  <div class="mx-auto max-w-[76rem] px-snug pt-section sm:px-line">
    <p class="label-mono m-0 text-ink-2">Patina UI · Marks</p>
    <h1 class="mb-tight mt-tight text-title">What the hand adds</h1>
    <p class="m-0 max-w-measure text-ink-2">
      Each mark means one thing, so readers learn them. Each takes its wobble,
      turn or shape from a seed: pass one, or let its text be the seed.
    </p>
  </div>

  <dl class="mx-auto mt-section max-w-[76rem] px-snug sm:px-line">
    <div class="mark-row">
      <dt>
        <code class="label-mono">Highlight</code>
        <span>This phrase matters</span>
      </dt>
      <dd>
        The heron <Highlight>was already standing in the shallows</Highlight>{" "}
        The <Highlight accent>accent</Highlight> variant prints in the region's
        drum.
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">HandUnderline</code>
        <span>A term, emphasized</span>
      </dt>
      <dd>
        <HandUnderline className="text-lead font-semibold">
          Ardea cinerea
        </HandUnderline>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Circle</code>
        <span>Look here</span>
      </dt>
      <dd>
        Count at dawn: <Circle>42</Circle> waders, and one{" "}
        <Circle data-ink="pink">bittern</Circle>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Strike</code>
        <span>No longer holds</span>
      </dt>
      <dd>
        Meet at the <Strike>harbour</Strike> sluice gate at seven.
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Bracket</code>
        <span>These belong together</span>
      </dt>
      <dd>
        <Bracket className="max-w-measure" data-ink="green">
          <p class="m-0">Note the time and the tide.</p>
          <p class="m-0">Sketch what you see before naming it.</p>
          <p class="m-0">Write the name last, and how sure you are.</p>
        </Bracket>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">SketchFrame</code>
        <span>A drawn box around a group</span>
      </dt>
      <dd class="flex flex-wrap gap-snug">
        {[
          "Which bird was it?",
          "How many were there?",
          "What was it doing?",
        ].map((q) => (
          <SketchFrame seed={q} className="px-snug py-tight">
            {q}
          </SketchFrame>
        ))}
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Wash</code>
        <span>This area belongs to the accent</span>
      </dt>
      <dd class="flex flex-wrap gap-section">
        <Wash ink="green" className="px-tight font-semibold">
          Seen today
        </Wash>
        <Wash ink="pink" className="px-tight font-semibold">
          Heard only
        </Wash>
        <Wash ink="blue" className="px-tight font-semibold">
          Confirmed
        </Wash>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Tape</code>
        <span>Pinned to the page</span>
        <span class="label-mono text-ink-3">Lively only</span>
      </dt>
      <dd class="flex flex-wrap gap-section pt-snug" data-variation="lively">
        {["pink", "green", "yellow"].map((ink) => (
          <div
            class="relative w-44 rounded-sheet bg-card px-snug pb-snug pt-line text-small leading-small shadow-sheet"
            style="background-image: var(--paper-texture); background-size: var(--paper-texture-size)"
          >
            <Tape ink={ink as "pink"} seed={ink} />A note held down with {ink}{" "}
            tape.
          </div>
        ))}
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">RoughRule</code>
        <span>A section boundary</span>
      </dt>
      <dd class="flex flex-col gap-tight">
        <RoughRule seed="a" />
        <RoughRule seed="b" />
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">MarginNote</code>
        <span>An aside from the reader</span>
      </dt>
      <dd>
        <MarginNote data-ink="pink">check against last spring</MarginNote>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Annotation</code>
        <span>Points at what it describes</span>
      </dt>
      <dd class="flex flex-col items-start gap-y-page py-snug">
        <Annotation note="best count this year" side="right">
          <b class="text-h2">72</b>
        </Annotation>
        <Annotation note="new" side="top" data-ink="green" className="ml-line">
          <span class="label-mono rounded-sheet border border-line px-tight py-hair">
            Export
          </span>
        </Annotation>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Stamp</code>
        <span>A verdict, stamped</span>
      </dt>
      <dd class="flex flex-wrap items-center gap-snug">
        <Stamp>Draft</Stamp>
        <Stamp data-ink="green">Verified</Stamp>
        <Stamp variant="solid" data-ink="pink">
          Rare
        </Stamp>
        <Stamp variant="solid">Recorded</Stamp>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <code class="label-mono">Glyph</code>
        <span>Hand-drawn signs</span>
      </dt>
      <dd>
        <ul class="m-0 flex list-none flex-wrap gap-x-snug gap-y-tight p-0">
          {GLYPHS.map((name) => (
            <li class="flex w-20 flex-col items-center gap-hair text-ink">
              <Glyph name={name} size={28} />
              <span class="label-mono text-ink-2">{name}</span>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
</Base>

<style>
  .mark-row {
    display: grid;
    gap: var(--space-hair) var(--space-section);
    padding-block: var(--space-snug);
    border-bottom: 1px dashed var(--rule);
  }
  @media (min-width: 48rem) {
    .mark-row {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: center;
    }
  }
  dt {
    display: flex;
    flex-direction: column;
    font-size: var(--type-small);
    line-height: var(--lh-small);
    color: var(--ink-2);
  }
  dt code {
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8rem;
  }
  dd {
    margin: 0;
  }
</style>
