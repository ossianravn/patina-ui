---
// Dev only: the observations screen started from another dataset, for worst-case checks
// (/fieldbook/data/worst, empty, one, thousand). The build generates none of these pages.
import Fieldbook from "@/site/layouts/fieldbook.astro"
import { Observations } from "@/site/fieldbook/observations"
import { DATASETS, type Dataset } from "@/site/fieldbook/worst-case"

const LABELS: Record<Dataset, string> = {
  demo: "Demo",
  worst: "Worst case",
  empty: "Empty",
  one: "One",
  thousand: "1,000 rows",
}

export function getStaticPaths() {
  return import.meta.env.DEV
    ? Object.keys(DATASETS).map((set) => ({ params: { set } }))
    : []
}

const set = Astro.params.set as Dataset
---

<Fieldbook title="Observations" section="observations">
  <Observations initial={DATASETS[set]} client:load />
  <nav
    aria-label="Demo data"
    style="position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:50;display:flex;gap:2px;padding:3px;border-radius:999px;background:#d4d4d8;font:500 13px/1 system-ui,sans-serif"
  >
    {(Object.keys(LABELS) as Dataset[]).map((key) => (
      <a
        href={`/fieldbook/data/${key}`}
        aria-current={key === set ? "true" : undefined}
        style={`padding:7px 12px;border-radius:999px;color:#18181b;text-decoration:none;white-space:nowrap;${key === set ? "background:#fff;box-shadow:0 1px 2px rgb(0 0 0/.15)" : ""}`}
      >
        {LABELS[key]}
      </a>
    ))}
  </nav>
</Fieldbook>
