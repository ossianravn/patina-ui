---
// In use: three Stageshow-style scenes built from real Patina components, each with a caption beside it that says
// what it shows and links the parts it is made of. Each scene is its own island, hydrated once the page is idle so it
// is ready (and back on its first frame) before it scrolls into view.
import SectionHead from "@/site/specimen/section-head.astro"
import { ChecklistScene } from "./scene-checklist"
import { MarginNoteScene } from "./scene-margin-note"
import { PaperStockScene } from "./scene-paper-stock"
import { sceneStockCss } from "./scene-stocks"

const stockCss = sceneStockCss(["archive", "newsprint"])
const PARTS = {
  note: [
    ["Highlight", "/marks"],
    ["Margin note", "/marks"],
    ["Button", "/docs/components/button"],
  ],
  stock: [
    ["Toggle group", "/docs/components/toggle-group"],
    ["Switch", "/docs/components/switch"],
    ["Print", "/prints"],
  ],
  checklist: [
    ["Checklist", "/docs/components/checklist"],
    ["Checkbox", "/docs/components/checkbox"],
    ["Stamp", "/marks"],
  ],
}
---

<style is:inline set:html={stockCss} />

<section
  class="mx-auto max-w-[76rem] px-snug py-section sm:px-line"
  aria-labelledby="in-use"
>
  <SectionHead n={2} id="in-use" title="In use">
    Real components doing their jobs in Fieldbook, the field notebook this kit
    was built with.
  </SectionHead>
  <ol class="m-0 flex list-none flex-col gap-section p-0">
    <li class="scene-row">
      <div class="scene-caption">
        <h3>A note in the margin</h3>
        <p>
          Select a phrase in an entry and write beside it. The highlighter
          follows the selection; the note arrives in the hand voice, pointing
          back at what it is about.
        </p>
        <p class="parts">
          {PARTS.note.map(([name, href], i) => (
            <>
              {i > 0 && " · "}
              <a href={href}>{name}</a>
            </>
          ))}
        </p>
      </div>
      <MarginNoteScene client:idle />
    </li>
    <li class="scene-row">
      <div class="scene-caption">
        <h3>New paper, same notebook</h3>
        <p>
          Choose a stock in Settings and every sheet reprints on it: paper,
          grain and the inks tuned to read on it.
        </p>
        <p class="parts">
          {PARTS.stock.map(([name, href], i) => (
            <>
              {i > 0 && " · "}
              <a href={href}>{name}</a>
            </>
          ))}
        </p>
      </div>
      <PaperStockScene client:idle />
    </li>
    <li class="scene-row">
      <div class="scene-caption">
        <h3>Ticked off before the tide</h3>
        <p>
          Each tick is drawn in where it lands and the tally keeps count; the
          last one completes the list.
        </p>
        <p class="parts">
          {PARTS.checklist.map(([name, href], i) => (
            <>
              {i > 0 && " · "}
              <a href={href}>{name}</a>
            </>
          ))}
        </p>
      </div>
      <ChecklistScene client:idle />
    </li>
  </ol>
</section>

<style>
  .scene-row {
    display: grid;
    gap: var(--space-snug) var(--space-section);
  }
  @media (min-width: 64rem) {
    .scene-row {
      grid-template-columns: minmax(14rem, 1fr) minmax(0, 40rem);
      align-items: center;
    }
  }
  .scene-caption {
    max-width: 24rem;
  }
  .scene-caption h3 {
    margin: 0;
    font-size: var(--type-lead);
    line-height: var(--lh-subhead);
  }
  .scene-caption p {
    margin: var(--space-hair) 0 0;
    color: var(--ink-2);
  }
  .scene-caption .parts {
    margin-top: var(--space-tight);
    font-family: var(--face-label);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
  }
</style>
