---
// Fieldbook's own frame: a product, not the docs. Its sections in a sidebar, its user, a quiet link back to Patina.
import "@/patina/styles/patina.css"
import { PatinaDefs } from "@/patina/defs/patina-defs"
import { appearanceScript } from "@/patina/theme/appearance-script"
import { siteAppearance } from "@/site/appearance"
import { FieldbookShell, type Section } from "@/site/fieldbook/shell"

interface Props {
  title: string
  /** The sidebar entry this page belongs to. Sign-in has none, and no sidebar. */
  section?: Section
}
const { title, section } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Fieldbook</title>
    <meta
      name="description"
      content="Fieldbook, a notebook for field research: a demo product built with Patina UI."
    />
    <script is:inline set:html={appearanceScript(siteAppearance)} />
  </head>
  <body>
    <PatinaDefs />
    <a
      class="label-mono absolute -left-[999px] top-2 z-30 bg-ink px-tight py-hair text-paper focus:left-2"
      href="#main"
    >
      Skip to content
    </a>
    {section ? (
      <FieldbookShell current={section} client:load>
        <slot />
      </FieldbookShell>
    ) : (
      <main id="main">
        <slot />
      </main>
    )}
  </body>
</html>
