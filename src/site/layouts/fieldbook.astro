---
// Fieldbook's own frame: a product, not the docs. Its mark, its navigation, its user; a quiet link back to Patina.
import "@/patina/styles/patina.css"
import { PatinaDefs } from "@/patina/defs/patina-defs"
import { appearanceScript } from "@/patina/theme/appearance-script"
import { print } from "@/patina/ink"

interface Props {
  title: string
  /** Sign-in has no navigation. */
  bare?: boolean
}
const { title, bare = false } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, "")
const NAV = [
  { href: "/fieldbook", label: "Observations" },
  { href: "/fieldbook/settings", label: "Settings" },
]
const mark = print({ motif: "sprig", seed: "fieldbook" }).svg
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Fieldbook</title>
    <meta
      name="description"
      content="Fieldbook, a notebook for field research: a demo product built with Patina UI."
    />
    <script is:inline set:html={appearanceScript()} />
  </head>
  <body>
    <PatinaDefs />
    <a
      class="label-mono absolute -left-[999px] top-2 z-30 bg-ink px-tight py-hair text-paper focus:left-2"
      href="#main"
    >
      Skip to content
    </a>
    {!bare && (
      <header class="border-b border-dashed border-rule">
        <div class="mx-auto flex h-16 max-w-[72rem] items-center gap-tight px-snug min-[24rem]:gap-snug sm:gap-section sm:px-line">
          <a href="/fieldbook" class="flex items-center gap-hair no-underline">
            <span class="block w-9" set:html={mark} />
            <span class="font-hand text-h2 leading-none font-bold max-[23rem]:sr-only">
              Fieldbook
            </span>
          </a>
          <nav
            aria-label="Fieldbook"
            class="flex items-center gap-tight sm:gap-snug"
          >
            {NAV.map(({ href, label }) => (
              <a
                href={href}
                aria-current={path === href ? "page" : undefined}
                class="label-mono text-ink-2 no-underline hover:text-ink aria-[current=page]:hand-underline aria-[current=page]:text-ink"
              >
                {label}
              </a>
            ))}
          </nav>
          <a href="/" class="label-mono ml-auto text-ink-3 max-sm:hidden">
            Demo · Patina UI
          </a>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
  </body>
</html>
