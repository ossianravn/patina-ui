---
// The site's page frame: pre-paint appearance, shared filters, header and footer.
import "@/patina/styles/patina.css"
import { PatinaDefs } from "@/patina/defs/patina-defs"
import { appearanceScript } from "@/patina/theme/appearance-script"
import { sketch } from "@/patina/ink"

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const fullTitle = title === "Patina UI" ? title : `${title} · Patina UI`
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const NAV = [
  { href: "/prints", label: "Prints" },
  { href: "/marks", label: "Marks" },
  { href: "/press", label: "Press" },
  { href: "/docs", label: "Docs" },
  { href: "/fieldbook", label: "Fieldbook" },
]

// The mark: a verdigris slab overprinted by a copper disc, a little out of register.
const solid = (color: string, seed: number) => ({
  seed,
  stroke: color,
  fill: color,
  fillStyle: "solid" as const,
  strokeWidth: 1,
  roughness: 0.6,
})
const logo =
  `<g class="patina-drum">${sketch.polygon(
    [
      [3, 6],
      [24, 3.5],
      [26.5, 24],
      [5, 26.5],
    ],
    solid("var(--print-green)", 11),
  )}</g>` +
  `<g class="patina-drum" style="translate:1px -0.5px">${sketch.circle(21, 20, 15, solid("var(--print-orange)", 12))}</g>`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <script is:inline set:html={appearanceScript()} />
  </head>
  <body>
    <PatinaDefs />
    <a
      class="label-mono absolute -left-[999px] top-2 z-30 bg-ink px-tight py-hair text-paper focus:left-2"
      href="#main"
    >
      Skip to content
    </a>
    <header class="site-header sticky top-0 z-20">
      <div class="mx-auto flex h-16 max-w-[76rem] items-center justify-between gap-snug px-snug sm:px-line">
        <a
          class="flex items-center gap-tight whitespace-nowrap no-underline"
          href="/"
        >
          <svg
            viewBox="0 0 32 32"
            width="30"
            height="30"
            aria-hidden="true"
            set:html={logo}
          />
          <span class="text-body leading-heading font-semibold tracking-[-0.01em] max-[30rem]:sr-only">
            Patina UI
          </span>
        </a>
        <nav
          aria-label="Main"
          class="flex items-center gap-hair min-[22rem]:gap-tight sm:gap-snug"
        >
          {NAV.map(({ href, label }) => (
            <a
              class="label-mono text-ink-2 no-underline hover:text-ink aria-[current=page]:highlight aria-[current=page]:text-ink"
              href={href}
              aria-current={
                path === href || path.startsWith(`${href}/`)
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer mt-page">
      <div class="mx-auto flex max-w-[76rem] flex-wrap justify-between gap-x-line gap-y-hair px-snug pb-section pt-line sm:px-line">
        <p class="label-mono m-0 text-ink-2">
          Patina UI · shadcn/ui, with a patina
        </p>
        <p class="label-mono m-0 text-ink-2">
          <a href="/studio">Theme studio</a> · <a href="/specimen">Specimen</a>{" "}
          · MIT · <a href="https://github.com/ossianravn/patina-ui">Source</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background-color: var(--paper);
    background-image: var(--paper-texture);
    background-size: var(--paper-texture-size);
  }
  .site-header::after,
  .site-footer::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 0.6rem;
    background: linear-gradient(var(--line), var(--line)) center / 100% 1.5px
      no-repeat;
    opacity: 0.7;
    filter: var(--rough-1);
  }
  .site-header::after {
    bottom: -0.3rem;
  }
  .site-footer {
    position: relative;
  }
  .site-footer::before {
    top: -0.3rem;
  }
</style>
