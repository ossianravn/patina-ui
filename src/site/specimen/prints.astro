---
// Paper objects from Fieldbook, the demo product: each one cut differently, printed from its own seed, and worn by
// the page's patina level.
import { print } from "@/patina/ink"
import { Paper } from "@/patina/paper/paper"
import { Stamp } from "@/patina/marks/stamp"
import SectionHead from "./section-head.astro"
---

<section
  class="mx-auto max-w-[76rem] px-snug py-section sm:px-line"
  aria-labelledby="objects"
>
  <SectionHead n={1} id="objects" title="Paper objects">
    Notes, tickets and receipts from a field notebook. Each takes its edge,
    tilt, print and wear from one seed; switch the patina to Worn and watch them
    age, or to Calm and they straighten.
  </SectionHead>

  <ul class="m-0 grid list-none items-start gap-section p-0 pt-snug sm:grid-cols-2 lg:grid-cols-4">
    <li>
      <Paper seed="obs-0412" edge="torn" tilt className="pt-line">
        <span
          class="mx-auto block w-3/4"
          set:html={print({ motif: "horizon", seed: "obs-0412" }).svg}
        />
        <p class="label-mono m-0 mt-tight text-k-ink">Observation No. 0412</p>
        <p class="m-0 mt-hair text-lead font-semibold leading-subhead">
          Grey heron
        </p>
        <p class="m-0 mt-hair text-small leading-small text-ink-2">
          Tidal flats, 05:42. Still for eleven minutes, then a single strike.
        </p>
      </Paper>
    </li>
    <li data-ink="orange">
      <Paper seed="stub-0017" edge="perforated" tilt className="pl-line">
        <p class="label-mono m-0 text-ink-2">Expedition · Stub 0017</p>
        <p class="m-0 mt-hair text-lead font-semibold leading-subhead">
          Saltmarsh walk
        </p>
        <p class="m-0 mt-hair text-small leading-small text-ink-2">
          Sat 14 Nov · Meet at the sluice gate, 07:00
        </p>
        <span
          class="mt-snug block w-1/2"
          set:html={print({ motif: "tiles", seed: "stub-0017" }).svg}
        />
        <Stamp variant="solid" className="mt-tight">
          Admit one
        </Stamp>
      </Paper>
    </li>
    <li data-ink="violet">
      <Paper seed="lichen-23" edge="deckle" dogEar tilt>
        <span
          class="mx-auto block w-2/3"
          set:html={print({ motif: "collage", seed: "lichen-23" }).svg}
        />
        <p class="label-mono m-0 mt-tight text-k-ink">Survey · 23 specimens</p>
        <p class="m-0 mt-hair text-lead font-semibold leading-subhead">
          Lichen on the sea wall
        </p>
        <p class="m-0 mt-hair text-small leading-small text-ink-2">
          Crustose and foliose, north face only.
        </p>
      </Paper>
    </li>
    <li>
      <Paper
        seed="supplies"
        edge="pinked"
        tilt
        className="pb-section font-label text-small leading-small"
      >
        <p class="label-mono m-0 text-center text-ink">Field supplies</p>
        <dl class="m-0 mt-tight grid grid-cols-[1fr_auto] gap-x-snug gap-y-hair">
          <dt>Notebook, waxed</dt>
          <dd class="m-0">6.50</dd>
          <dt>Hand lens ×10</dt>
          <dd class="m-0">14.00</dd>
          <dt>Specimen vials</dt>
          <dd class="m-0">3.20</dd>
          <dt class="font-bold">Total</dt>
          <dd class="m-0 font-bold">23.70</dd>
        </dl>
        <span
          class="mx-auto mt-snug block w-2/5"
          set:html={print({ motif: "lino", seed: "supplies" }).svg}
        />
      </Paper>
    </li>
  </ul>
</section>
