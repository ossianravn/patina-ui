---
import { sketch } from "@/patina/ink"
import SectionHead from "./section-head.astro"

const svg = (w: number, h: number, body: string) =>
  `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" aria-hidden="true">${body}</svg>`
const ring = (i: number) =>
  svg(
    34,
    34,
    sketch.circle(17, 17, 28, {
      seed: 50 + i,
      stroke: "var(--k)",
      strokeWidth: 1.6,
      roughness: 1.1,
    }),
  )
const BOX = svg(
  22,
  22,
  sketch.rect(2, 2, 18, 18, {
    seed: 21,
    stroke: "var(--line)",
    strokeWidth: 1.5,
    roughness: 1.2,
  }),
)
const CHECK = svg(
  26,
  26,
  sketch.curve(
    [
      [4, 13],
      [10, 20],
      [24, 2],
    ],
    { seed: 22, stroke: "var(--k)", strokeWidth: 2.8, roughness: 0.8 },
  ),
)
const ARROW = sketch.arrow(
  40,
  6,
  4,
  16,
  { seed: 9, stroke: "currentColor", strokeWidth: 1.5, roughness: 1 },
  -0.25,
  6,
)
const STEPS = [
  "Name the decision you're about to make",
  "Imagine it failed a year from now",
  "Write down why",
]
const TICKS = [
  "You've already spent a lot on it",
  "Stopping feels like admitting a mistake",
]
---

<section
  class="mx-auto max-w-[76rem] px-snug py-section sm:px-line"
  aria-labelledby="marks"
>
  <SectionHead n={6} id="marks" title="Marks">
    What the hand adds to the page. Each mark means one thing, so readers learn
    them.
  </SectionHead>
  <dl class="m-0">
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Highlight</span>
        <span class="text-small text-ink-2">This phrase matters</span>
      </dt>
      <dd>
        Sunk costs are{" "}
        <span class="highlight">already gone, whatever you decide next.</span>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Hand underline</span>
        <span class="text-small text-ink-2">A term, emphasized</span>
      </dt>
      <dd>
        <span class="hand-underline text-lead font-semibold">Pre-mortem</span>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Sketch frame</span>
        <span class="text-small text-ink-2">A drawn box around a group</span>
      </dt>
      <dd>
        <span class="sketch-frame inline-block px-snug py-tight">
          What kind of idea is it?
        </span>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Wash</span>
        <span class="text-small text-ink-2">
          This area belongs to the accent
        </span>
      </dt>
      <dd>
        <span class="wash inline-block px-tight font-semibold" data-ink="green">
          Tools to try
        </span>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Margin note</span>
        <span class="text-small text-ink-2">An aside from the reader</span>
      </dt>
      <dd>
        <p class="margin-note m-0 flex items-start gap-hair" data-ink="pink">
          <svg
            class="mt-hair"
            width="44"
            height="22"
            viewBox="0 0 44 22"
            aria-hidden="true"
            set:html={ARROW}
          />
          tick what rings true
        </p>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Ringed steps</span>
        <span class="text-small text-ink-2">Step or reason N</span>
      </dt>
      <dd>
        <ol class="m-0 flex list-none flex-col gap-hair p-0">
          {STEPS.map((step, i) => (
            <li class="flex items-center gap-tight">
              <span
                class="relative inline-grid size-[34px] shrink-0 place-items-center"
                aria-hidden="true"
              >
                <span class="absolute inset-0" set:html={ring(i)} />
                <b class="relative text-small">{i + 1}</b>
              </span>
              {step}
            </li>
          ))}
        </ol>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Checklist</span>
        <span class="text-small text-ink-2">Tick what applies</span>
      </dt>
      <dd>
        <ul class="m-0 flex list-none flex-col gap-hair p-0">
          {TICKS.map((tick) => (
            <li>
              <label class="tick flex cursor-pointer items-center gap-tight">
                <input type="checkbox" class="sr-only" />
                <span class="mark relative inline-block size-[26px] shrink-0">
                  <span class="absolute left-0.5 top-0.5" set:html={BOX} />
                  <span
                    class="check absolute inset-0 opacity-0 transition-opacity"
                    set:html={CHECK}
                  />
                </span>
                {tick}
              </label>
            </li>
          ))}
        </ul>
      </dd>
    </div>
    <div class="mark-row">
      <dt>
        <span class="label-mono text-ink">Rough rule</span>
        <span class="text-small text-ink-2">A section boundary</span>
      </dt>
      <dd class="flex items-center">
        <hr class="rough-rule m-0 w-full" />
      </dd>
    </div>
  </dl>
</section>

<style>
  .mark-row {
    display: grid;
    gap: var(--space-hair) var(--space-snug);
    padding-block: var(--space-snug);
    border-bottom: 1px dashed var(--rule);
  }
  @media (min-width: 48rem) {
    .mark-row {
      grid-template-columns: 14rem minmax(0, 1fr);
      align-items: center;
    }
  }
  dt {
    display: flex;
    flex-direction: column;
  }
  dd {
    margin: 0;
  }
  .tick input:checked + .mark .check {
    opacity: 1;
  }
  .tick input:focus-visible + .mark {
    outline: 2px dashed var(--k-ink);
    outline-offset: 3px;
  }
</style>
